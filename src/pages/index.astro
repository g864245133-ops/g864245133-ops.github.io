---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";
---

<BaseLayout title={`${site.name} — Academic Portfolio`}>
  <section class="hero shell">
    <div>
      <p class="eyebrow">Biomedical research · AI for Science</p>
      <h1>{site.name}</h1>
      <p class="lede">Ph.D. candidate investigating epigenetic mechanisms and therapeutic resistance in B-cell lymphoma, with a growing focus on computational approaches for scientific discovery.</p>
      <div class="link-row">
        <a class="text-link" href="/research">View research</a>
        <a class="text-link" href="/publications">Read publications</a>
      </div>
    </div>
    <aside class="identity-panel" aria-label="Current position">
      <p><strong>{site.title}</strong></p>
      <p>{site.program}</p>
      <p>{site.affiliation}</p>
      <p class="muted">{site.location}</p>
    </aside>
  </section>

  <section class="section">
    <div class="shell">
      <div class="section-heading">
        <h2>Research trajectory</h2>
        <p>From single-cell chromatin accessibility and tumor regulatory networks to experimental studies of B-cell lymphoma biology.</p>
      </div>
      <div class="card-grid">
        <article class="card">
          <p class="card-number">01 · 2019–2022</p>
          <h3>Single-cell genomics</h3>
          <p>scATAC-seq analysis of medulloblastoma subgroups and gene regulatory networks.</p>
        </article>
        <article class="card">
          <p class="card-number">02 · Current</p>
          <h3>B-cell lymphoma</h3>
          <p>DNA methylation, epigenetic mechanisms, drug resistance, and experimental validation.</p>
        </article>
        <article class="card">
          <p class="card-number">03 · Developing</p>
          <h3>AI for Science</h3>
          <p>A portfolio of reproducible learning projects will document the transition into AI-enabled research.</p>
        </article>
      </div>
    </div>
  </section>
</BaseLayout>
