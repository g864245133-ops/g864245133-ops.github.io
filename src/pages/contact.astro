---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageIntro from "../components/PageIntro.astro";
import { site } from "../data/site";
---

<BaseLayout title="Contact — Xiaoyue Gao">
  <PageIntro eyebrow="Contact" title="Let’s connect" introduction="I welcome conversations about computational biology, cancer genomics, translational bioinformatics, industry roles, postdoctoral opportunities, research collaborations, and science communication." />
  <section class="content-grid shell"><p class="side-label">Email</p><div class="split-grid">
    <article class="card"><p class="card-number">Current academic contact</p><h2>University email</h2><p><a href={`mailto:${site.email}`}>{site.email}</a></p></article>
    <article class="card"><p class="card-number">Long-term contact</p><h2>Personal email</h2><p><a href={`mailto:${site.personalEmail}`}>{site.personalEmail}</a></p></article>
  </div></section>
  <section class="content-grid shell"><p class="side-label">Profiles</p><div class="card-grid">
    <article class="card"><h2>LinkedIn</h2><p>Professional opportunities and research conversations.</p><div class="link-row"><a class="text-link" href={site.profiles.linkedin}>View LinkedIn</a></div></article>
    <article class="card"><h2>Google Scholar</h2><p>Publications and citation profile.</p><div class="link-row"><a class="text-link" href={site.profiles.scholar}>View Scholar</a></div></article>
    <article class="card"><h2>GitHub & ORCID</h2><p>Developing computational work and persistent researcher record.</p><div class="link-row"><a class="text-link" href={site.profiles.github}>GitHub</a><a class="text-link" href={site.profiles.orcid}>ORCID</a></div></article>
  </div></section>
  <section class="section"><div class="shell section-heading"><h2>Areas of interest</h2><div><ul class="compact-list"><li>Computational biology and cancer genomics</li><li>Translational bioinformatics and multi-omics research</li><li>AI-enabled biomedical research</li><li>Industry and computational postdoctoral opportunities</li><li>Research collaboration and science communication</li></ul><p>I am open to conversations about future opportunities and collaborations. Please contact me by email or LinkedIn.</p></div></div></section>
</BaseLayout>
