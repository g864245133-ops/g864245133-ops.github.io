---
import { site } from "../data/site";
---

<footer class="site-footer">
  <div class="shell footer-inner">
    <p>© {new Date().getFullYear()} {site.name}</p>
    <div class="footer-links" aria-label="Professional profiles">
      <a href={site.profiles.github}>GitHub</a>
      <a href={site.profiles.scholar}>Google Scholar</a>
      <a href={site.profiles.linkedin}>LinkedIn</a>
      <a href={site.profiles.orcid}>ORCID</a>
    </div>
  </div>
</footer>
